r lastInlineDiv;\r\n\r\n\t\t// const inlineDivs = document.querySelectorAll('#mw-content-text .mw-parser-output div[id^=\"div-gpt-ad-300-inline\"]');\r\n\t\t// if (inlineDivs.length > 0) {\r\n\t\t// \tlastInlineDiv = inlineDivs[inlineDivs.length-1];\r\n\t\t// \tlet match = /(\\d+)$/.exec(lastInlineDiv.id);\r\n\t\t// \tinserted = (match) ? match[1] : 0;\r\n\t\t// }\r\n\r\n\t\t// inject on page ads\r\n\t\tfunction checkPageLength() {\r\n\t\t\treturn document.getElementById('mw-content-text').offsetHeight >= window.innerHeight * 2;\r\n\t\t}\r\n\r\n\t\tfunction getInsertionPoints() {\r\n\t\t\tconst elms = document.querySelectorAll('#mw-content-text > div > h1, #mw-content-text > div > h2, #mw-content-text > div > h3, #mw-content-text > div > p:not(.mw-empty-elt), #mw-content-text > div > div.t-cb-container, #mw-content-text > div > table');\r\n\t\t\t// if (lastInlineDiv) {\r\n\t\t\t// \treturn Array.from(elms).filter(element => {\r\n\t\t\t// \t\treturn element.compareDocumentPosition(lastInlineDiv) & Node.DOCUMENT_POSITION_PRECEDING;\r\n\t\t\t// \t});\r\n\t\t\t// }\r\n\t\t\treturn elms;\r\n\t\t}\r\n\r\n\t\tfunction getColumnCount(table) {\r\n\t\t\treturn Math.max(...Array.from(table.rows).map(row => {\r\n\t\t\t\treturn Array.from(row.cells).reduce((sum, cell) => sum + (cell.colSpan || 1), 0);\r\n\t\t\t}));\r\n\t\t}\r\n\r\n\t\tfunction getAdDiv(i, adUnitName) {\r\n\t\t\tvar wrapperDiv = document.createElement('div');\r\n\t\t\twrapperDiv.className = 'section-vu';\r\n\r\n\t\t\tvar inlineAdDiv = document.createElement('div');\r\n\t\t\tinlineAdDiv.style = 'min-width: 320px; min-height: 250px; clear: both; text-align: center;';\r\n\t\t\tinlineAdDiv.id = 'div-gpt-ad-auto-inline-'+i;\r\n\t\t\tinlineAdDiv.dataset.adUnitId = '/1015505/'+adUnitName;\r\n\r\n\t\t\tvar inlineAdScript = document.createElement('script');\r\n\t\t\tinlineAdScript.innerHTML = 'relevantDigital.cmd.push(function() { rdSmartLoad(\"'+inlineAdDiv.id+'\"); });';\r\n\t\t\tinlineAdDiv.appendChild(inlineAdScript);\r\n\r\n\t\t\twrapperDiv.appendChild(inlineAdDiv);\r\n\t\t\treturn wrapperDiv;\r\n\t\t}\r\n\r\n\t\tfunction isAdNearby(element, minDistance) {\r\n\t\t\tconst existingAds = document.querySelectorAll('div.leaderboard-ad, div.section-vu');\r\n\t\t\tfor (const ad of existingAds) {\r\n\t\t\t\tlet elmRect = element.getBoundingClientRect();\r\n\t\t\t\tlet elmTop = elmRect.top + window.scrollY;\r\n\t\t\t\tlet adRect = ad.getBoundingClientRect();\r\n\t\t\t\tlet adTop = adRect.top + window.scrollY;\r\n\r\n\t\t\t\tlet distance = Math.abs(elmTop - (adTop + ad.offsetHeight));\r\n\t\t\t\tif (distance < minDistance) {\r\n\t\t\t\t\treturn true; // Ad is too close\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\treturn false; // No ad nearby\r\n\t\t}\r\n\r\n\t\tfunction getMinDistance() {\r\n\t\t\tlet distanceRatio = (document.body.classList.contains('touch-events') ? 1.8 : 0.8);\r\n\t\t\treturn Math.floor(window.innerHeight * distanceRatio); // Minimum distance in pixels between ads\r\n\t\t}\r\n\r\n\t\tfunction insertAdsBetweenContent() {\r\n\t\t\tconst insertionPoints = getInsertionPoints();\r\n\t\t\tconst minDistance = getMinDistance();\r\n\r\n\t\t\tinserted++;\r\n\t\t\tlet inline_count = inserted, table_inline_count = 1;\r\n\t\t\tloop1:\r\n\t\t\t\tfor (let i = 0; i < insertionPoints.length; i++) {\r\n\t\t\t\t\tlet elm = insertionPoints[i];\r\n\t\t\t\t\tif (elm.tagName === 'TABLE' && elm.rows.length > 15) {\r\n\t\t\t\t\t\tlet table = elm;\r\n\t\t\t\t\t\tlet columnCount = getColumnCount(table);\r\n\r\n\t\t\t\t\t\tloop2:\r\n\t\t\t\t\t\t\tfor (let j = 6; j < table.rows.length; j++) {\r\n\t\t\t\t\t\t\t\tlet row = table.rows[j];\r\n\t\t\t\t\t\t\t\tif (!isAdNearby(row, minDistance)) {\r\n\t\t\t\t\t\t\t\t\tconst newRow = table.insertRow(j + 1);\r\n\t\t\t\t\t\t\t\t\tnewRow.className = 'no-sort';\r\n\t\t\t\t\t\t\t\t\tconst newCell = newRow.insertCell(0);\r\n\t\t\t\t\t\t\t\t\tnewCell.colSpan = columnCount;\r\n\r\n\t\t\t\t\t\t\t\t\tlet adDiv = getAdDiv(inserted, 'SPLW_300x250_Inline'+table_inline_count);\r\n\t\t\t\t\t\t\t\t\tnewCell.appendChild(adDiv);\r\n\t\t\t\t\t\t\t\t\tif (is_NYM_debugging_enabled) {\r\n\t\t\t\t\t\t\t\t\t\tconsole.log('div-gpt-ad-auto-inline-' + inserted, ' inserted in row ', j + 1, row);\r\n\t\t\t\t\t\t\t\t\t}\r\n\r\n\t\t\t\t\t\t\t\t\tif (inserted == maxInjectedAds) {\r\n\t\t\t\t\t\t\t\t\t\tbreak loop1;\r\n\t\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\t\tinserted++;\r\n\t\t\t\t\t\t\t\t\ttable_inline_count++;\r\n\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t} else {\r\n\t\t\t\t\t\tif (!isAdNearby(elm, minDistance)) {\r\n\t\t\t\t\t\t\tlet adDiv = getAdDiv(inline_count, 'SPLW_300x250_Inline'+inline_count);\r\n\t\t\t\t\t\t\tlet pos = (elm.tagName.indexOf('H') === 0) ? 'beforebegin' : 'afterend';\r\n\r\n\t\t\t\t\t\t\telm.insertAdjacentElement(pos, adDiv);\r\n\t\t\t\t\t\t\tif (is_NYM_debugging_enabled) {\r\n\t\t\t\t\t\t\t\tconsole.log('div-gpt-ad-auto-inline-' + inserted, ' inserted ', pos, elm);\r\n\t\t\t\t\t\t\t}\r\n\r\n\t\t\t\t\t\t\tif (inserted == maxInjectedAds) {\r\n\t\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\tinserted++;\r\n\t\t\t\t\t\t\tinline_count++;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t}\r\n\r\n\t\tif (checkPageLength()) {\r\n\t\t\tinsertAdsBetweenContent();\r\n\t\t}\r\n\t}\r\n}\r\n\r\nif (document.readyState === \"loading\") {\r\n\tdocument.addEventListener(\"DOMContentLoaded\", nym_inject_ads);\r\n} else {\r\n\tnym_inject_ads();\r\n}\r\n\r\n\r\n","convertToCurrency":null,"pbsRoundTripBufferMs":200,"mcmChildNwid":0,"priceGranularity":"custom","customPriceGranularityRanges":[{"increment":0.01,"max":9},{"increment":0.05,"max":20},{"increment":0.2,"max":100}],"customPriceGranularityPrecision":2,"adServerCurrency":"USD","geoWaitMs":500,"optUseStorage":true,"optMinReloadSec":300,"storedReq":{"includebidderkeys":false,"preferdeals":false,"convertBidFloorCur":null,"tmax":null,"addNetworkBidAdjustment":false},"loadPbjs":false,"pbjsURL":"https://apps-cdn.relevant-digital.com/static/prebid_releases/prebid_current.js","pbjsVe